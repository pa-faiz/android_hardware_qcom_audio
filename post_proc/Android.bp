cc_library_shared {
    name: "libqcompostprocbundle",
    relative_install_path: "soundfx",
    vendor: true,

    owner: "qti",

    srcs: [
        "bundle.c",
        "equalizer.c",
        "bass_boost.c",
        "virtualizer.c",
        "reverb.c",
        "effect_api.c",
        "effect_util.c",
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Werror",
        "-DDTS_EAGLE",
    ],

    include_dirs: [
        "external/tinyalsa/include",
        "system/media/audio_effects/include",
    ],

    header_libs: [
        "libhardware_headers",
        "libsystem_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libtinyalsa",
    ],

    sanitize: {
        integer_overflow: true,
    },
}

cc_library_shared {
    name: "libvolumelistener",
    relative_install_path: "soundfx",
    vendor: true,
    owner: "qti",

    srcs: [
        "volume_listener.c"
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Werror",
        "-DLIB_AUDIO_HAL=/vendor/lib/hw/audio.primary.msmnile",
    ],

    include_dirs: [
        "external/tinyalsa/include",
        "external/tinycompress/include",
        "vendor/qcom/opensource/audio-hal/primary-hal/hal",
        "vendor/qcom/opensource/audio-hal/primary-hal/hal/audio_extn",
        "system/media/audio_route/include",
        "system/media/audio_utils/include",
    ],

    header_libs: [
        "libhardware_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],

    sanitize: {
        integer_overflow: true,
    },
}
